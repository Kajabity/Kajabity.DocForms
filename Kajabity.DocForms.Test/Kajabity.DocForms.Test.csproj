<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\DocForms.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.14" />
    <ProjectReference Include="..\Kajabity.DocForms\Kajabity.DocForms.csproj" />
    <ProjectReference Include="..\Samples\PlainTextEditor\PlainTextEditor.csproj" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="..\Samples\PlainTextEditor\PlainText*.cs" Link="LegacySample\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Samples\PlainTextEditor\PlainTextEditorMainForm.resx" LogicalName="PlainTextEditor.PlainTextEditorMainForm.resources" />
    <Compile Include="..\WindowsOnlyAssemblyInfo.cs" Link="Properties\WindowsOnlyAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Forms\test.txt" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
