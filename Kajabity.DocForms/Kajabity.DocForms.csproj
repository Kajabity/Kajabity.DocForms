<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>Kajabity.DocForms</RootNamespace>
    <AssemblyName>Kajabity.DocForms</AssemblyName>
    <ProjectGuid>{15F2E1E6-D8B9-4AF1-85BB-7D28BD88B9BD}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFramework)' == 'net48'">false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Kajabity.DocForms.snk</AssemblyOriginatorKeyFile>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <FileAlignment>4096</FileAlignment>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Platforms>AnyCPU;x86</Platforms>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <Version Condition="'$(ReleaseVersion)' == ''">0.4.1</Version>
    <Version Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</Version>
    <PackageId>Kajabity.DocForms</PackageId>
    <Title>Kajabity.DocForms</Title>
    <Authors>Kajabity.com</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Kajabity/Kajabity.DocForms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kajabity/Kajabity.DocForms.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>kajabity.docforms.logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Description>Document lifecycle helpers for Windows Forms applications: new, open, save, recent files, close confirmation and opt-in window placement. Supports .NET Framework 4.8 and .NET 10 for Windows.</Description>
    <PackageReleaseNotes>0.4.1 fixes zero and reduced recent-file limits, CSV sample column counts and saving, and broadens NuGet vulnerability auditing. The signed assembly version remains 0.4.0.0.</PackageReleaseNotes>
    <Copyright>Copyright © 2009-2026 Williams Technologies Limited.</Copyright>
    <PackageTags>WinForms;Windows Forms;documents;SDI;recent files;window placement</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86' or '$(Platform)' == 'AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <RegisterForComInterop>false</RegisterForComInterop>
    <GenerateSerializationAssemblies>Auto</GenerateSerializationAssemblies>
    <BaseAddress>4194304</BaseAddress>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="Forms\SingleDocumentForm.cs" SubType="Form" />
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\kajabity.docforms.logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="..\WindowsOnlyAssemblyInfo.cs" Link="Properties\WindowsOnlyAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <BootstrapperPackage Include="Microsoft.Net.Client.3.5">
      <Visible>False</Visible>
      <ProductName>.NET Framework 3.5 SP1 Client Profile</ProductName>
      <Install>false</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.Net.Framework.3.5.SP1">
      <Visible>False</Visible>
      <ProductName>.NET Framework 3.5 SP1</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.Windows.Installer.3.1">
      <Visible>False</Visible>
      <ProductName>Windows Installer 3.1</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
  </ItemGroup>
  <Target Name="GenerateDocFormsVersion" BeforeTargets="CoreCompile">
    <Error Condition="'$(ReleaseVersion)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ReleaseVersion)', '^[0-9]+\.[0-9]+\.[0-9]+$'))"
           Text="ReleaseVersion must use X.Y.Z format (for example, 0.3.0)." />
    <PropertyGroup>
      <_DocFormsVersion Condition="'$(ReleaseVersion)' == ''">0.4.1</_DocFormsVersion>
      <_DocFormsVersion Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</_DocFormsVersion>
      <_DocFormsInformationalVersion>$(_DocFormsVersion)</_DocFormsInformationalVersion>
      <_DocFormsInformationalVersion Condition="'$(ReleaseVersion)' == ''">$(_DocFormsVersion)-dev</_DocFormsInformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <_DocFormsVersionAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(_DocFormsVersion).0</_Parameter1>
      </_DocFormsVersionAttribute>
      <_DocFormsVersionAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(_DocFormsInformationalVersion)</_Parameter1>
      </_DocFormsVersionAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" AssemblyAttributes="@(_DocFormsVersionAttribute)"
                       OutputDirectory="$(IntermediateOutputPath)" OutputFile="DocForms.Version.g.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
</Project>
